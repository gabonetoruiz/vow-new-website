---
layout: layouts/base.njk
title: Contact
description: "Book a VOW demo, ask a question or get the VOW GO app for guests."
styles: [contact]
scripts: [contact]
motion: [reveal, hover, contact]
---
<div class="ct">
  <header class="ct-hero" aria-labelledby="ct-title">
    <div class="wrap ct-split">
      <h1 class="ct-title" id="ct-title" data-ct="title">Let’s Talk</h1>
      <div class="ct-side">
        <p class="ct-intro" data-ct="intro">Send a line or two. Whether you want to <a href="#demo">book a demo</a>, have a <a href="#options">question</a> about VOW, or you’re attending an event <a href="#guests">as a guest</a>, this is the place to start.</p>
        <ul class="ct-options" id="options">
          <li data-ct="option"><span>Book Demo</span><a href="#demo">Share your event details</a></li>
          <li data-ct="option"><span>Custom Sales Deck</span><a href="#deck">Request a deck</a></li>
          <li data-ct="option"><span>Questions and support</span><a translate="no" href="mailto:{{ contact.email }}?subject=I%20have%20a%20question">{{ contact.email }}</a></li>
          <li data-ct="option"><span>Press and media</span><a translate="no" href="mailto:{{ contact.email }}?subject=Press%20inquiry">{{ contact.email }}</a></li>
          <li data-ct="option"><span>For guests</span><a href="#guests">Get the VOW GO app</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap">
      <ul class="ct-social" aria-label="VOW on social media" data-ct="social">
        {%- for s in contact.social %}
        <li><a href="{{ s.url }}" rel="noopener">{{ s.label }} <svg aria-hidden="true"><use href="#arrow-ne"/></svg></a></li>
        {%- endfor %}
      </ul>
    </div>
  </header>

  <div class="ct-photo-wrap">
    <figure class="ct-photo" data-ct="photo">
      <img src="/assets/img/sector-grandscale.jpg" alt="Aerial night view of an illuminated multi-venue event campus" width="1920" height="1433" decoding="async">
    </figure>
  </div>

  <section class="ct-demo" id="demo" aria-labelledby="demo-title">
    <div class="wrap ct-split">
      <div class="ct-demo-head">
        <h2 class="h2" id="demo-title" data-reveal>Book Demo</h2>
        <p class="lede" data-reveal>Share the event and the guests you’re planning for. Then pick a time to see VOW with its CEO.</p>
      </div>
      <div class="ct-side" data-reveal>
        <form class="ct-form" id="demoForm" novalidate data-hs-do-not-collect="true"
              data-portal="{{ contact.hubspot.portalId }}" data-form="{{ contact.hubspot.formId }}">
          <p class="ct-required">All fields are required.</p>
          <div class="field"><label for="f-first">First name</label><input id="f-first" name="firstname" data-object="0-1" autocomplete="given-name" required></div>
          <div class="field"><label for="f-last">Last name</label><input id="f-last" name="lastname" data-object="0-1" autocomplete="family-name" required></div>
          <div class="field"><label for="f-email">Work email</label><input id="f-email" name="email" type="email" inputmode="email" spellcheck="false" autocapitalize="off" data-object="0-1" autocomplete="email" required></div>
          <div class="field"><label for="f-company">Company name</label><input id="f-company" name="company" data-object="0-1" autocomplete="organization" required></div>
          <div class="field wide"><label for="f-event">Date of your next live event or experience</label><input id="f-event" name="date_of_next_first_upcoming_event" type="date" data-object="0-2" required></div>
          <fieldset class="wide" id="industries" aria-describedby="industries-error">
            <legend>Industry or type of events (choose at least one)</legend>
            <div class="choices">
              {%- for i in contact.industries %}
              <label class="choice"><input type="checkbox" name="type_of_events___experiences" data-object="0-2" value="{{ i }}"><span>{{ i }}</span></label>
              {%- endfor %}
            </div>
            <p class="error" id="industries-error"></p>
          </fieldset>
          <div class="field"><label for="f-demo1">Preferred date for a Zoom demo</label><input id="f-demo1" name="your_preferred_date_and_time_for_zoom_demo" type="date" data-object="0-1" data-future required></div>
          <div class="field"><label for="f-demo2">Second preferred date</label><input id="f-demo2" name="your_second___2__preferred_date_for_zoom_demo" type="date" data-object="0-1" data-future required></div>
          {#- Honeypot: hidden from people, filled in by simple bots #}
          <div class="trap" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off"></label></div>
          <div class="wide ct-submit">
            <button type="submit" class="btn btn-primary"><span class="ct-spinner" aria-hidden="true"></span><span class="ct-label">Request a Demo</span> <svg aria-hidden="true"><use href="#arrow-ne"/></svg></button>
            <p class="ct-privacy">VOW uses these details to arrange your demo, and HubSpot processes them on its behalf. If you accepted cookies, your visits to this site are linked to your request. See the <a href="/privacy-policy/">Privacy Policy</a>.</p>
          </div>
          <p class="wide ct-status" id="formStatus" role="alert"></p>
        </form>
        <div class="ct-thanks" id="formThanks" tabindex="-1" hidden>
          <h3>Thank You for Your Interest in VOW.</h3>
          <p>One more step: choose a time for your personalized demo with VOW’s CEO.</p>
          <a class="btn btn-primary" href="{{ contact.meetingsUrl }}" rel="noopener">Schedule Your Demo <svg aria-hidden="true"><use href="#arrow-ne"/></svg></a>
        </div>
        <noscript><p class="ct-privacy">The form needs JavaScript. You can also email <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>.</p></noscript>
      </div>
    </div>
  </section>

  <section class="ct-demo ct-deck" id="deck" aria-labelledby="deck-title">
    <div class="wrap ct-split">
      <div class="ct-demo-head">
        <h2 class="h2" id="deck-title" data-reveal>Custom Sales Deck</h2>
        <p class="lede" data-reveal>VOW provides custom Product and Sales Decks to verified potential customers within 3 business days.</p>
        <p class="lede" data-reveal>To request a Custom VOW Product and Sales Deck, enter information here:</p>
      </div>
      <div class="ct-side" data-reveal>
        {#- deckFormId in _data/contact.json: the HubSpot form for these requests. While it is empty, the form offers email instead. #}
        <form class="ct-form" id="deckForm" novalidate data-hs-do-not-collect="true"
              data-portal="{{ contact.hubspot.portalId }}" data-form="{{ contact.hubspot.deckFormId }}" data-email="{{ contact.email }}">
          <p class="ct-required">All fields are required.</p>
          <div class="field"><label for="d-first">First name</label><input id="d-first" name="firstname" data-object="0-1" autocomplete="given-name" required></div>
          <div class="field"><label for="d-last">Last name</label><input id="d-last" name="lastname" data-object="0-1" autocomplete="family-name" required></div>
          <div class="field"><label for="d-email">Work email</label><input id="d-email" name="email" data-object="0-1" type="email" inputmode="email" spellcheck="false" autocapitalize="off" autocomplete="email" required></div>
          <div class="field"><label for="d-company">Company name</label><input id="d-company" name="company" data-object="0-1" autocomplete="organization" required></div>
          <div class="field"><label for="d-domain">Company domain</label><input id="d-domain" name="company_domain" data-object="0-1" inputmode="url" spellcheck="false" autocapitalize="off" placeholder="company.com" required></div>
          <div class="field"><label for="d-requesting">Requesting</label><input id="d-requesting" name="deck_requesting" data-object="0-1"  required></div>
          <div class="field"><label for="d-sector">Sector</label>
            <select id="d-sector" name="deck_sector" data-object="0-1" required>
              <option value="">Choose a sector</option>
              {%- for s in sectors %}
              <option>{{ s.name }}</option>
              {%- endfor %}
            </select>
          </div>
          <div class="field"><label for="d-usecase">Primary use case</label><input id="d-usecase" name="deck_primary_use_case" data-object="0-1"  required></div>
          <div class="field wide"><label for="d-volume">Annual number of events and experiences</label><input id="d-volume" name="deck_annual_events" data-object="0-1" inputmode="numeric" required></div>
          <div class="trap" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off"></label></div>
          <div class="wide ct-submit">
            <button type="submit" class="btn btn-primary"><span class="ct-spinner" aria-hidden="true"></span><span class="ct-label">Request a Deck</span> <svg aria-hidden="true"><use href="#arrow-ne"/></svg></button>
            <p class="ct-privacy">VOW uses these details to verify and answer your request{% if contact.hubspot.deckFormId %}, and HubSpot processes them on its behalf{% endif %}. See the <a href="/privacy-policy/">Privacy Policy</a>.</p>
          </div>
          <p class="wide ct-status" id="deckStatus" role="alert"></p>
        </form>
        <div class="ct-thanks" id="deckThanks" tabindex="-1" hidden>
          <h3>Thank You for Your Request.</h3>
          <p>VOW provides custom decks to verified potential customers within 3 business days.</p>
        </div>
        <noscript><p class="ct-privacy">The form needs JavaScript. You can also email <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>.</p></noscript>
      </div>
    </div>
  </section>

  <section class="ct-band" id="guests" aria-labelledby="guests-title">
    <div class="wrap ct-split">
      <div class="ct-band-copy">
        <p data-reveal>Attending an event?<br><em>Get VOW GO for guests.</em></p>
        <ul data-reveal>
          {%- for a in contact.apps %}
          <li><a class="btn btn-ghost" href="{{ a.url }}" rel="noopener">{{ a.label }} <svg aria-hidden="true"><use href="#arrow-ne"/></svg></a></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="ct-band-title">
        <i class="ct-line" aria-hidden="true"></i>
        <h2 id="guests-title" data-ct="big"><span>Your Night,</span> <span>in Your Pocket.</span></h2>
      </div>
    </div>
  </section>
</div>
