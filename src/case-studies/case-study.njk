---
layout: layouts/base.njk
pagination:
  data: caseStudies
  size: 1
  alias: cs
permalink: "/case-studies/{{ cs.slug }}/"
eleventyComputed:
  title: "{{ cs.title }}"
  description: "{{ cs.lede }}"
styles: [inner, case]
scripts: [cards]
motion: [reveal, hover, case, cta]
---
{#- One template for every case study: add an entry to src/_data/caseStudies.json and a page appears. -#}
<article class="cs">
  <div class="cs-glows" aria-hidden="true"><i class="g g1"></i><i class="g g2"></i><i class="g g3"></i><i class="g g4"></i></div>

  <header class="cs-hero" aria-labelledby="cs-title">
    <div class="wrap">
      <p class="crumb" data-cs="in"><a href="/#cases">Case studies</a></p>
      <h1 class="cs-title" id="cs-title" data-cs="title">{{ cs.title }}</h1>
      <p class="lede cs-lede" data-cs="in">{{ cs.lede }}</p>
      <dl class="cs-meta" data-cs="meta">
        <div><dt>Client</dt><dd>{{ cs.client }}</dd></div>
        <div><dt>Year</dt><dd>{{ cs.year }}</dd></div>
        <div><dt>Sector</dt><dd>{{ cs.sector }}</dd></div>
        <div><dt>Platform</dt><dd>{{ cs.platform }}</dd></div>
      </dl>
    </div>
    <div class="wrap cs-cover-wrap">
      <figure class="cs-cover" data-cs="cover">
        <img src="{{ cs.cover.src }}" alt="{{ cs.cover.alt }}" width="{{ cs.cover.w }}" height="{{ cs.cover.h }}" decoding="async" fetchpriority="high">
      </figure>
    </div>
  </header>

  <section class="cs-intro" aria-label="Overview">
    <div class="wrap cs-split">
      <p class="cs-statement" data-cs="statement">
        {%- for w in cs.statement.split(' ') %}<span class="w">{{ w }}</span> {% endfor %}
      </p>
      <p class="cs-note" data-reveal>{{ cs.note }}</p>
    </div>
  </section>

  {%- for s in cs.sections %}
  <section class="cs-block" id="{{ s.id }}" aria-labelledby="{{ s.id }}-title">
    <div class="wrap cs-split">
      <h2 class="cs-h" id="{{ s.id }}-title" data-reveal>{{ s.title }}</h2>
      <div class="cs-copy">
        {%- for para in s.text %}<p data-reveal>{{ para }}</p>{% endfor %}
      </div>
    </div>
  </section>
  {%- endfor %}

  {%- if cs.metrics %}
  <section class="cs-metrics" aria-label="Key figures">
    <div class="wrap">
      <ul class="figures">
        {%- for m in cs.metrics %}
        <li data-reveal>
          <p class="figure-num" data-count="{{ m.value }}" data-suffix="{{ m.suffix }}">{{ m.value }}{{ m.suffix }}</p>
          <p>{{ m.label }}</p>
        </li>
        {%- endfor %}
      </ul>
      {%- if cs.metricsNote %}<p class="cs-fine" data-reveal>{{ cs.metricsNote }}</p>{% endif %}
    </div>
  </section>
  {%- endif %}

  {%- for m in cs.media %}
  <section class="cs-media cs-{{ m.type }}" aria-label="{{ m.caption }}">
    <div class="wrap">
      {%- if m.type == "full" %}
      <figure class="cs-frame" data-cs="frame">
        <img src="{{ m.src }}" alt="{{ m.alt }}" width="{{ m.w }}" height="{{ m.h }}" loading="lazy" decoding="async">
      </figure>
      {%- elif m.type == "device" %}
      <figure class="cs-frame cs-stage" data-cs="frame">
        <img class="bg" src="{{ m.bg }}" alt="" width="{{ m.bgW }}" height="{{ m.bgH }}" loading="lazy" decoding="async">
        <picture><source srcset="{{ m.src }}.avif" type="image/avif"><img class="fg" src="{{ m.src }}.webp" alt="{{ m.alt }}" width="{{ m.w }}" height="{{ m.h }}" loading="lazy" decoding="async"></picture>
      </figure>
      {%- elif m.type == "pair" %}
      <div class="cs-duo">
        {%- for im in m.images %}
        <figure class="cs-frame" data-cs="frame">
          <img src="{{ im.src }}"{% if im.focus %} style="object-position:{{ im.focus }}"{% endif %} alt="{{ im.alt }}" width="{{ im.w }}" height="{{ im.h }}" loading="lazy" decoding="async">
        </figure>
        {%- endfor %}
      </div>
      {%- endif %}
      <p class="cs-caption" data-reveal>{{ m.caption }}</p>
    </div>
  </section>
  {%- endfor %}

  {%- if cs.results %}
  <section class="cs-block" id="results" aria-labelledby="results-title">
    <div class="wrap cs-split">
      <h2 class="cs-h" id="results-title" data-reveal>{{ cs.results.title }}</h2>
      <div class="cs-copy">
        {%- for para in cs.results.text %}<p data-reveal>{{ para }}</p>{% endfor %}
      </div>
    </div>
  </section>
  {%- endif %}

  <nav class="cs-back" aria-label="More case studies">
    <div class="wrap">
      <a class="link" href="/#cases" data-reveal><svg class="back" aria-hidden="true"><use href="#chevron"/></svg> All case studies</a>
    </div>
  </nav>
</article>

{% include "cta.njk" %}
