---
layout: layouts/base.njk
title: Gallery
description: "Photos from the premium events VOW helps bring to life."
styles: [inner, gallery]
scripts: [gallery]
motion: [reveal, cta]
---
{% set heroTitle = "Gallery" %}
{% set heroLede = "Moments from the events VOW helps bring to life." %}
{% include "page-hero.njk" %}

<section class="section tight flush-top" aria-label="Photo gallery">
  <div class="wrap">
    <div class="g-filters chips" role="group" aria-label="Filter photos by sector" data-reveal>
      <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
      {%- for s in galleryFilters %}
      <button type="button" class="chip" data-filter="{{ s.slug }}" aria-pressed="false">{{ s.name }}</button>
      {%- endfor %}
    </div>
    <p class="sr-only" id="gStatus" role="status" aria-live="polite"></p>
  </div>

  {# Infinite stage. The list below is the data source (and the text alternative); script.js builds the cards from it. #}
  <div class="g-stage" id="gStage" tabindex="0" role="group" aria-roledescription="infinite photo canvas"
       aria-label="Photo gallery. Drag or use the arrow buttons to explore, press Enter to open the centred photo, arrow keys to move.">
    <div class="g-world" id="gWorld"></div>
    <p class="g-hint" id="gHint" aria-hidden="true"><span class="g-hint-dot"></span>Drag to explore · Click a photo to open</p>
    {# Arrow buttons: the same movement as the arrow keys, for anyone who can't or would rather not drag #}
    <div class="g-pan" role="group" aria-label="Move around the gallery">
      <button type="button" data-pan="ArrowLeft" aria-label="Move left"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
      <button type="button" data-pan="ArrowUp" aria-label="Move up"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
      <button type="button" data-pan="ArrowDown" aria-label="Move down"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
      <button type="button" data-pan="ArrowRight" aria-label="Move right"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
    </div>
    <div class="g-focus" id="gFocus" role="dialog" aria-modal="true" aria-label="Photo" hidden>
      <button type="button" class="g-focus-close" aria-label="Close photo"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
      <div class="g-focus-tilt" id="gTilt">
        <img class="g-focus-img" id="gFocusImg" alt="">
        <div class="g-focus-cap" aria-hidden="true">
          <p class="g-t" id="gT"></p>
          <p class="g-m" id="gM"></p>
          <p class="g-d" id="gD"></p>
        </div>
        <p class="sr-only" id="gFocusSr"></p>
      </div>
    </div>
  </div>

  <ul class="sr-only" id="gSource" aria-label="All photos">
    {%- for p in gallery %}
    <li data-src="{{ p.src | url }}" data-w="{{ p.w }}" data-h="{{ p.h }}" data-sector="{{ p.sector }}" data-title="{{ p.title }}" data-meta="{{ p.meta }}" data-desc="{{ p.desc }}" data-alt="{{ p.alt }}">{{ p.title }}. {{ p.alt }}</li>
    {%- endfor %}
  </ul>
  <noscript>
    <div class="wrap"><div class="g-static">
      {%- for p in gallery %}
      <figure><img src="{{ p.src }}" alt="{{ p.alt }}" width="{{ p.w }}" height="{{ p.h }}" loading="lazy"><figcaption>{{ p.title }}</figcaption></figure>
      {%- endfor %}
    </div></div>
  </noscript>
</section>

{% include "cta.njk" %}
