---
layout: layouts/base.njk
pagination:
  data: sectors
  size: 1
  alias: sector
permalink: "/sectors/{{ sector.slug }}/"
eleventyComputed:
  title: "{{ sector.name }}"
  description: "{{ sector.intro }}"
styles: [inner]
scripts: [cards]
motion: [reveal, hover]
---
{% set heroKicker = "Sectors" %}
{% set heroTitle = sector.name %}
{% set heroLede = sector.intro %}
{% include "page-hero.njk" %}

<section class="section tight flush-top" aria-label="{{ sector.name }} at a glance">
  <div class="wrap">
    <figure class="sector-banner" data-reveal>
      <img src="{{ sector.image }}" alt="{{ sector.imageAlt }}" width="{{ sector.imageW }}" height="{{ sector.imageH }}" decoding="async" fetchpriority="high">
    </figure>
  </div>
</section>

<section class="section tight" aria-labelledby="help-title">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2" id="help-title" data-reveal>How VOW helps in {{ sector.name }}</h2>
    </div>
    <div class="points">
      {%- for p in sector.points %}
      <article class="point glow" data-reveal>
        <h3>{{ p.title }}</h3>
        <p>{{ p.text }}</p>
      </article>
      {%- endfor %}
    </div>
    <div class="sector-links" data-reveal>
      {%- if galleryBySector[sector.slug] %}
      <a class="link" href="/gallery/#{{ sector.slug }}">See {{ sector.name }} photos <svg aria-hidden="true"><use href="#arrow-ne"/></svg></a>
      {%- endif %}
      {%- if sector.related %}
      <a class="link" href="{{ sector.related.url }}">{{ sector.related.label }} <svg aria-hidden="true"><use href="#arrow-ne"/></svg></a>
      {%- endif %}
    </div>
  </div>
</section>

<section class="section tight others" aria-labelledby="others-title">
  <div class="wrap">
    <h2 id="others-title" data-reveal>Explore other sectors</h2>
    <ul class="chips" data-reveal>
      {%- for s in sectors %}{% if s.slug != sector.slug %}
      <li><a class="chip" href="/sectors/{{ s.slug }}/">{{ s.name }}</a></li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>

{% include "cta.njk" %}
