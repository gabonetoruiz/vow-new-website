<section class="page-hero" aria-labelledby="page-title">
  <div class="wrap">
    {%- if heroKicker %}
    <p class="crumb" data-reveal>{{ heroKicker }}</p>
    {%- endif %}
    <h1 class="page-title" id="page-title" data-reveal>{{ heroTitle }}</h1>
    {%- if heroLede %}
    <p class="lede" data-reveal>{{ heroLede }}</p>
    {%- endif %}
  </div>
</section>
