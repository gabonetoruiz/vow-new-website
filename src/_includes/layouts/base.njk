<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow"><!-- Review phase: keep out of search results. Remove at launch. -->
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0F0A4E">
<title>{% if pageTitle %}{{ pageTitle }}{% else %}{{ title }} — VOW{% endif %}</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<script>
  // Mark JS as available so GSAP can own first paint; never leave content hidden if GSAP fails to start.
  document.documentElement.classList.add('js');
  setTimeout(function(){ if(!document.documentElement.classList.contains('gsap-ready')) document.documentElement.classList.remove('js'); }, 3000);
</script>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/components.css">
<link rel="stylesheet" href="/css/nav.css">
{%- for name in styles %}
<link rel="stylesheet" href="/css/{{ name }}.css">
{%- endfor %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

{% include "sprite.njk" %}

{% include "header.njk" %}

<main id="main">
<span id="top"></span>
{{ content | safe }}
</main>

{% include "footer.njk" %}

<!-- Scripts: classic scripts in dependency order (the 'js' flag above stays inline so first paint is never flashed) -->
<script src="/js/nav.js"></script>
{%- for name in scripts %}
<script src="/js/{{ name }}.js"></script>
{%- endfor %}
{%- if motion %}

<!-- GSAP motion layer -->
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
<script src="/js/motion-core.js"></script>
{%- for name in motion %}
<script src="/js/motion-{{ name }}.js"></script>
{%- endfor %}
{%- endif %}
</body>
</html>
