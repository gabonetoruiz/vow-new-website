{%- set onSector = page.url.startsWith("/sectors/") -%}
<header class="nav" id="nav">
  <div class="wrap">
    <a href="/" class="logo" aria-label="VOW, home"{% if page.url == "/" %} aria-current="page"{% endif %} data-hero="nav"><svg viewBox="0 0 156 32" aria-hidden="true"><use href="#vow-logo"/></svg></a>

    <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navPanel" aria-label="Open menu" data-hero="nav">
      <span class="bars" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav class="nav-panel" id="navPanel" aria-label="Primary">
      <ul class="nav-list">
        <li class="nav-item has-sub{% if onSector %} is-current{% endif %}" style="--i:0" data-hero="nav">
          <button type="button" class="nav-link sub-trigger" aria-expanded="false" aria-controls="sub-sectors">{{ nav.sectorsLabel }}<svg aria-hidden="true"><use href="#chevron"/></svg></button>
          <div class="sub" id="sub-sectors">
            <ul class="sub-list">
              {%- for s in sectors %}
              <li><a href="/sectors/{{ s.slug }}/"{% if page.url == "/sectors/" + s.slug + "/" %} aria-current="page"{% endif %}><span class="sub-name">{{ s.name }}</span><span class="sub-blurb">{{ s.blurb }}</span></a></li>
              {%- endfor %}
            </ul>
          </div>
        </li>
        {%- for l in nav.links %}
        <li class="nav-item" style="--i:{{ loop.index }}" data-hero="nav"><a class="nav-link" href="{{ l.url }}"{% if page.url == l.url %} aria-current="page"{% endif %}>{{ l.label }}</a></li>
        {%- endfor %}
      </ul>
      <a href="{{ site.connectUrl }}" class="btn btn-primary nav-cta"{% if page.url == site.connectUrl %} aria-current="page"{% endif %} data-hero="nav">{{ nav.ctaLabel }}</a>
    </nav>
  </div>
</header>
