{#- Cookie choice for HubSpot lead tracking. Shown by js/consent.js; nothing from HubSpot loads before "Accept". #}
<section class="consent" id="consent" aria-labelledby="consent-title" tabindex="-1" hidden
         data-portal="{{ contact.hubspot.portalId }}">
  <h2 id="consent-title">Cookies</h2>
  <p>With your permission, HubSpot cookies measure site use and link your visits to demo requests. <a href="/privacy-policy/#cookies">Privacy Policy</a></p>
  <p class="consent-note" id="consentNote" hidden></p>
  <div class="consent-actions">
    <button type="button" class="btn btn-ghost" data-consent="denied">Decline</button>
    <button type="button" class="btn btn-ghost" data-consent="granted">Accept</button>
  </div>
</section>
