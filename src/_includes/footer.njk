<footer>
  <div class="wrap">
    <div class="foot-top">
      <a href="/" class="logo" aria-label="VOW, home"><svg viewBox="0 0 156 32" aria-hidden="true"><use href="#vow-logo"/></svg></a>
      <nav aria-label="Footer">
        <ul class="foot-links">
          {%- for l in nav.links %}
          <li><a href="{{ l.url }}"{% if page.url == l.url %} aria-current="page"{% endif %}>{{ l.label }}</a></li>
          {%- endfor %}
          <li><a href="{{ site.connectUrl }}"{% if page.url == site.connectUrl %} aria-current="page"{% endif %}>Contact</a></li>
        </ul>
      </nav>
    </div>
    <ul class="foot-sectors" aria-label="Sectors">
      {%- for s in sectors %}
      <li><a href="/sectors/{{ s.slug }}/">{{ s.name }}</a></li>
      {%- endfor %}
    </ul>
    <div class="foot-base">
      <span>B2B2VIP. Real-time. End-to-end.</span>
      <div class="legal"><a href="/privacy-policy/"{% if page.url == "/privacy-policy/" %} aria-current="page"{% endif %}>Privacy Policy</a><a href="/terms-of-service-vow/"{% if page.url == "/terms-of-service-vow/" %} aria-current="page"{% endif %}>Terms of Service</a><button type="button" data-cookie-settings hidden>Cookie settings</button><span>© 2026 VOW</span></div>
    </div>
  </div>
</footer>
