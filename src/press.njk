---
layout: layouts/base.njk
title: Press
description: "Latest news and insights from VOW, and how to reach our team for media inquiries."
styles: [inner]
scripts: [cards]
motion: [reveal, hover, cta]
---
{#- Heading and intro as on the current vow.app press page -#}
{#- Entries marked "sample" in press.json are never shown. With no real entries the page holds only the media contact. #}
{%- set articles = press.items | rejectattr("sample") %}
{%- set heroKicker = "Press" %}
{%- set heroTitle = "Latest News & Insights from VOW" if articles.length else "Press" %}
{%- set heroLede = "Stay updated on industry trends, product updates, success stories, and expert guides that power the future of event and guest experience technology." if articles.length else "How to reach us for media inquiries." %}
{% include "page-hero.njk" %}

{%- if articles.length %}
<section class="section tight flush-top" aria-label="Press coverage">
  <div class="wrap">
    <ul class="press-list">
      {%- for item in articles %}
      <li class="press-row" data-reveal>
        <div class="press-thumb">
          {%- if item.image %}<img src="{{ item.image }}" alt="" width="496" height="446" {% if loop.index > 2 %}loading="lazy" {% endif %}decoding="async">{% endif -%}
        </div>
        <div>
          <p class="press-meta"><span class="press-outlet">{{ item.outlet }}</span> <time datetime="{{ item.date }}">{{ item.date | dateLong }}</time></p>
          <h2 class="press-title"><a href="{{ item.url }}" rel="noopener">{{ item.title }}</a></h2>
        </div>
        <span class="press-go" aria-hidden="true"><svg><use href="#arrow-ne"/></svg><svg><use href="#arrow-ne"/></svg></span>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

<section class="section tight{% if not articles.length %} flush-top{% endif %}" aria-labelledby="inquiries-title">
  <div class="wrap press-contact">
    <div class="copy">
      <h2 class="h2" id="inquiries-title" data-reveal>Media inquiries</h2>
      <p class="lede" data-reveal>For interviews, images or information about VOW, get in touch with our team.</p>
    </div>
    <div class="act" data-reveal><a class="btn btn-primary" href="/contact/">Contact the team</a></div>
  </div>
</section>

{% include "cta.njk" %}
